{
  "name": "resume-matcher",
  "version": "0.0.1",
  "description": "Veridis Quo.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:backend": "cd apps/backend && uv sync",
    "dev:backend": "cd apps/backend && uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 --timeout-keep-alive 300 --timeout-graceful-shutdown 300",
    "dev:frontend": "cd apps/frontend && bun run dev",
    "dev": "concurrently \"bun:dev:backend\" \"bun:dev:frontend\"",
    "build:frontend": "cd apps/frontend && bun run build",
    "build:backend": "cd apps/backend && uv run python -c \"print('Backend build complete')\"",
    "build": "bun run build:frontend && bun run build:backend",
    "start:backend": "cd apps/backend && uv run uvicorn app.main:app --port 8000",
    "start:frontend": "cd apps/frontend && bun run start",
    "start": "concurrently \"bun:start:backend\" \"bun:start:frontend\"",
    "lint:frontend": "cd apps/frontend && bun run lint",
    "lint:fix:frontend": "cd apps/frontend && bun run lint:fix",
    "lint:backend": "cd apps/backend && uv run ruff check .",
    "lint:fix:backend": "cd apps/backend && uv run ruff check --fix .",
    "lint": "bun run lint:frontend && bun run lint:backend",
    "lint:fix": "bun run lint:fix:frontend && bun run lint:fix:backend",
    "type-check:frontend": "cd apps/frontend && bun run type-check",
    "type-check:backend": "cd apps/backend && uv run pyright",
    "type-check": "bun run type-check:frontend && bun run type-check:backend",
    "type-check:errors": "bun run scripts/type-check-errors.js",
    "type-check:errors:frontend": "bun run scripts/type-check-errors.js frontend",
    "type-check:errors:backend": "bun run scripts/type-check-errors.js backend",
    "format:frontend": "cd apps/frontend && bun run format",
    "format": "bun run format:frontend",
    "analyze:frontend": "cd apps/frontend && bun run analyze",
    "analyze": "bun run analyze:frontend",
    "test:frontend": "cd apps/frontend && bun run test",
    "test:backend": "cd apps/backend && uv run python -m pytest",
    "test": "concurrently \"bun:test:frontend\" \"bun:test:backend\"",
    "test:watch": "cd apps/frontend && bun run test:watch",
    "clean": "rm -rf apps/frontend/.next apps/frontend/out apps/frontend/dist node_modules apps/frontend/node_modules apps/backend/.venv",
    "clean:frontend": "cd apps/frontend && rm -rf .next out dist node_modules",
    "clean:backend": "cd apps/backend && rm -rf .venv __pycache__ .pytest_cache",
    "precommit": "bunx lint-staged",
    "prepare": "husky",
    "git:status": "git status",
    "git:wip": "bun run scripts/git-wip.js",
    "git:save": "bun run scripts/git-save.js",
    "git:done": "bun run scripts/git-done.js",
    "git:push": "git push",
    "git:branch": "bun run scripts/git-branch.js",
    "git:switch": "bun run scripts/git-switch.js",
    "git:pr": "bun run scripts/git-pr.js",
    "git:cleanup": "bun run scripts/git-cleanup.js",
    "git:backup": "bun run scripts/git-backup.js",
    "git:health-check": "bun run scripts/git-health-check.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "concurrently": "^9.1.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0"
  }
}
